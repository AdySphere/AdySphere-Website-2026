# Resend API key for the contact form (https://resend.com). Required in production.
RESEND_API_KEY=
# Where booking requests are sent. Defaults to mallicka@adysphere.com.
CONTACT_TO=mallicka@adysphere.com
# Sender address. The domain must be verified in Resend.
CONTACT_FROM="AdySphere Co. website <website@adysphere.com>"
# Optional: Calendly or Microsoft Bookings URL, shown under the booking form.
NEXT_PUBLIC_BOOKING_URL=
